# =====================================================================
# AUTH + DATA STORE
#
# Two modes:
#  (A) Firebase (recommended, persistent): set the FIREBASE_* vars below.
#      Users are managed in the Firebase console; sites persist in Firestore.
#  (B) Env fallback (local dev, in-memory): leave FIREBASE_* unset and use
#      APP_USERS / ADMIN_* below. Data resets on restart.
# Login fails closed if neither mode is configured. No in-app self-registration.
# =====================================================================

# --- (A) Firebase ---------------------------------------------------
# Web API key (Project settings → General → "Web API Key"). Used server-side to
# verify email/password via the Identity Toolkit REST API. Setting this switches
# authentication to Firebase Authentication (email is the login "username").
# FIREBASE_API_KEY=""

# Service account for Firestore (Admin SDK). Either paste the FULL service-account
# JSON on one line (or base64-encode it)...
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}'
# ...or provide the three fields individually (escape newlines in the key as \n):
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# --- (B) Env fallback (used only when Firebase is not configured) ----
# Multi-user: APP_USERS is a JSON array of { username, password } (optional "id" to
# pin a stable data-scoping key; defaults to username). Each user has their own sites.
#   APP_USERS='[{"username":"alice","password":"pw1"},{"username":"bob","password":"pw2"}]'
# Single-user (legacy) fallback, used only when APP_USERS is unset:
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Which user id gets the seeded example sites on first login (in-memory mode only).
# Defaults to ADMIN_USERNAME.
# SEED_USER="admin"

# --- Session signing (REQUIRED) ---
# Secret used to HMAC-sign the session cookie. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Session lifetime in seconds (optional, default 28800 = 8h).
# SESSION_MAX_AGE="28800"

# --- Public app URL (optional) ---
# Absolute origin the app is served from. Used as `metadataBase` so Open Graph /
# Twitter image URLs resolve to absolute links when the page is shared. Defaults
# to http://localhost:3000 for local dev.
# APP_URL="https://revalidator.internal.example"

# --- Revalidation SSRF allowlist (optional but recommended) ---
# Comma-separated hosts, domain suffixes, or CIDRs that are permitted revalidate targets
# in ADDITION to public hosts. Use this to explicitly allow your internal/VPN-only sites.
# Cloud-metadata and loopback addresses are ALWAYS blocked regardless of this list.
# Examples: "internal.corp.example,10.0.0.0/8,uat.mycompany.example"
# REVALIDATE_ALLOWED_HOSTS=""
